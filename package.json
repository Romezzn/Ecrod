{
  "name": "emergency-cord",
  "version": "1.0.0",
  "description": "Discord backup web app ultra rápido para servidor Docker",
  "main": "electron-main.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "electron": "electron electron-main.js",
    "dist": "electron-builder --win"
  },
  "build": {
    "appId": "es.dimzo.emergencycord",
    "productName": "EmergencyCord",
    "win": {
      "target": [
        "portable",
        "nsis"
      ],
      "icon": "public/favicon.ico"
    },
    "portable": {
      "artifactName": "EmergencyCord-Portable.exe",
      "requestExecutionLevel": "user"
    },
    "nsis": {
      "oneClick": true,
      "allowToChangeInstallationDirectory": false,
      "artifactName": "EmergencyCord-Setup.exe"
    },
    "files": [
      "electron-main.js",
      "server.js",
      "package.json",
      "public/**/*"
    ],
    "directories": {
      "output": "dist"
    }
  },
  "dependencies": {
    "express": "^4.19.2",
    "socket.io": "^4.7.5"
  },
  "devDependencies": {
    "electron": "^29.1.0",
    "electron-builder": "^24.13.3"
  }
}
